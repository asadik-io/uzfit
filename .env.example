NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only privileged key; choose the key type supported by the project.
SUPABASE_SECRET_KEY=
PAYMENT_PROVIDER=demo
PAYMENT_MERCHANT_ID=
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=
CRON_SECRET=

# ---------------------------------------------------------------------------
# Optional settings (documented in README.md → "Environment variables")
# ---------------------------------------------------------------------------
# Marks a non-Vercel host as production (Vercel sets VERCEL_ENV automatically).
# Production refuses the demo payment adapter and demo account setup.
# APP_ENV=development
# Public support address shown on the profile page.
# NEXT_PUBLIC_SUPPORT_EMAIL=
# Password for the local demo accounts created by `pnpm setup:demo` (random if unset).
# DEMO_PASSWORD=
# Allows `pnpm setup:demo` against a non-local Supabase project (never for production).
# ALLOW_DEMO_SETUP=false
# End-to-end tests (Playwright).
# E2E_BASE_URL=http://localhost:3000
# E2E_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# MAILPIT_URL=http://127.0.0.1:54324
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=
