# The demo needs no external services; every value below is optional.

# Public origin used for absolute links (defaults to http://localhost:3000).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payment adapter for new checkouts: demo (simulated provider), payme, click, or none.
PAYMENT_PROVIDER=demo
# Demo adapter signing key; falls back to a per-process key when unset.
PAYMENT_WEBHOOK_SECRET=
# Reserved for a real provider adapter.
PAYMENT_MERCHANT_ID=
PAYMENT_API_SECRET=

# Shared password of the demo accounts shown on the sign-in page (default: UzFitDemo2026).
DEMO_PASSWORD=
# Signs the session cookie; use a long random string in deployments.
DEMO_SESSION_SECRET=
# Bearer secret for /api/jobs/reconcile.
CRON_SECRET=

# Marks a non-Vercel host as production (Vercel sets VERCEL_ENV automatically).
# APP_ENV=development
# Public support address shown on the profile page.
# NEXT_PUBLIC_SUPPORT_EMAIL=
